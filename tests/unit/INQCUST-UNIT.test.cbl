           SET AZ-RECORD-PTR TO DATA-PTR
           COMPUTE AZ-RECORD-PTR-VALUE = AZ-RECORD-PTR-VALUE +
             LENGTH OF WK-RECORD-COUNT * 2 * (AZ-GRP-INDEX - 1)
